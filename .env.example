# ==============================================================================
# EVA4 BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env and replace placeholder values with your
# actual configuration. NEVER commit the real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE SETTINGS
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-in-production-to-a-very-long-and-cryptographically-random-string

# Set to False in production!
DEBUG=False

# Comma-separated list of allowed hostnames, IP addresses, or domain names
# Example: api.tu-dominio.com,localhost,127.0.0.1,ec2-xx-xx-xx-xx.compute-1.amazonaws.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# 2. CORS SETTINGS (Frontend EC2 Integration)
# ------------------------------------------------------------------------------
# Comma-separated list of frontend origins permitted to make cross-origin requests
# Example: http://frontend-ec2-ip:3000,https://app.tu-dominio.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Allow all origins (ONLY set to True for testing when DEBUG=True, NEVER in production)
CORS_ALLOW_ALL_ORIGINS=False

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Amazon RDS PostgreSQL / SQLite Local Fallback)
# ------------------------------------------------------------------------------
# Set DB_ENGINE=django.db.backends.postgresql to use Amazon RDS PostgreSQL.
# Leave blank or set to django.db.backends.sqlite3 for local development.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=eva4_db
DB_USER=eva4_dbuser
DB_PASSWORD=YourStrongDatabasePassword123!
DB_HOST=eva4-postgres.c123456789.us-east-1.rds.amazonaws.com
DB_PORT=5432

# SSL Mode for PostgreSQL connection to RDS: require, verify-ca, verify-full, prefer
DB_SSLMODE=require
DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 4. AMAZON S3 STORAGE CONFIGURATION (django-storages / boto3)
# ------------------------------------------------------------------------------
# Set USE_S3=True to store static files and user uploads in Amazon S3
USE_S3=False
AWS_STORAGE_BUCKET_NAME=eva4-backend-storage-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Optional: CloudFront CDN custom domain for S3 assets
# AWS_S3_CUSTOM_DOMAIN=d111111abcdef8.cloudfront.net

# Local paths used when USE_S3=False
STATIC_ROOT=/home/ubuntu/apps/static
MEDIA_ROOT=/home/ubuntu/apps/media

# ------------------------------------------------------------------------------
# 5. JWT AUTHENTICATION SETTINGS
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# ------------------------------------------------------------------------------
# 6. SECURITY & SSL HEADERS (Production)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000
